# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback hotspot the board raises if it cannot join the WiFi above.
ap_password: "CHANGE_ME_12_CHARS"

# Home Assistant native API encryption key (base64, 32 bytes).
api_encryption_key: "GENERATE_ME"

# OTA update password.
ota_password: "GENERATE_ME"
